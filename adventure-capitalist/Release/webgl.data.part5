			function isGuest()
			{
				return kongregate.services.isGuest();
			}

			function getUsername()
			{
				var name = kongregate.services.getUsername();
				return name;
			}

			function getUserId()
			{
				return kongregate.services.getUserId();
			}

			function getAuthToken()
			{
				return kongregate.services.getGameAuthToken();
			}

			function showSignInBox()
			{
				if(kongregate.services.isGuest())
  					kongregate.services.showSignInBox();
			}

			function submitStat(statName, value)
			{
				kongregate.stats.submit(statName, value);
			}

			function getUserItems()
			{
				if (!isGuest())
					kongregate.mtx.requestUserItemList(null, onUserItems);
			}

			function onUserItems(result)
			{
				if (result.success)
				{
					var items = '';
					for (var i = 0; i < result.data.length; i++)
					{
						items += result.data[i].identifier;
						if (i < result.data.length - 1)
							items += ',';
					}
					SendUnityMessage('SetUserItems', items);
				}
				else
				{
					SendUnityMessage('SetUserItems', '');
				}
			}

			function purchaseItem(item)
			{
				var callback = function(result) {
					onPurchaseResult(result, item);
				};

				kongregate.mtx.purchaseItems([item], callback);
				//kongregate.mtx.purchaseItems([item], onPurchaseResult);
				SendUnityMessage('LogMessage', 'purchase sent....');				
			}

			function onPurchaseResult(result, item)
			{
				if (result.success)
				{
					SendUnityMessage('LogMessage', 'Purchase succeeded...');
					SendUnityMessage('PurchaseSuccess', item);
				}
				else
				{
					SendUnityMessage('PurchaseFail', item);
				}
			} 

			function registerLoginListener()
			{
				kongregate.services.addEventListener('login', onUserLogin);
			}

			function onUserLogin()
			{
				var services = kongregate.services;
				var params = [services.getUserId(), services.getUsername(), services.getGameAuthToken()].join('|');
				SendUnityMessage('KongregateUserSignedIn', params);
			}

			// Utility function to send data back to Unity
			function SendUnityMessage(functionName, message)
			{
				Log('Calling to: ' + functionName);
				var unity = kongregateUnitySupport.getUnityObject();
				unity.SendMessage('KongregateJavascriptBridge', 'Event', functionName + '|' + message);
			}

			function Log(message)
			{
				var unity = kongregateUnitySupport.getUnityObject();
				unity.SendMessage('KongregateJavascriptBridge', 'Event', 'LogMessage|' + message);
			}
		
			if(typeof(kongregateUnitySupport) != 'undefined')
			{
  				kongregateUnitySupport.initAPI('KongregateJavascriptBridge', 'KongregateAPILoaded');
  			};
